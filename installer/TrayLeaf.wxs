<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="轻羽归栈 TrayLeaf" Language="2052" Version="0.9.5" Manufacturer="TrayLeaf" UpgradeCode="{49F5C6BF-41D9-5CF1-8FFA-917E45CCB2DC}" Codepage="936">
    <!-- Elevated engine can update rollback-file security on protected/custom drives.
         Do not set ALLUSERS: preserve the existing per-user upgrade context. -->
    <Package Id="*" InstallerVersion="500" Compressed="yes" InstallPrivileges="elevated" Platform="x64" Description="轻羽归栈 TrayLeaf v0.9.5 安装程序" Comments="Windows 10/11 x64；当前用户安装；安装时请求提升权限以支持覆盖更新。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 TrayLeaf，请先卸载较新版本。" Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <Property Id="ARPPRODUCTICON" Value="TrayLeafIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes"><RegistrySearch Id="PreviousDesktopChoice" Root="HKCU" Key="Software\TrayLeaf\Installer" Name="DesktopChoice" Type="raw" Win64="yes" /></Property>
    <Property Id="STARTMENU_SHORTCUT" Value="1" Secure="yes"><RegistrySearch Id="PreviousMenuChoice" Root="HKCU" Key="Software\TrayLeaf\Installer" Name="MenuChoice" Type="raw" Win64="yes" /></Property>
    <Property Id="AUTO_START" Secure="yes"><RegistrySearch Id="PreviousStartupChoice" Root="HKCU" Key="Software\TrayLeaf\Preferences" Name="AutoStart" Type="raw" Win64="yes" /></Property>
    <!-- Remember a custom destination during maintenance/uninstall as well as install. -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="SavedInstallFolder" Root="HKCU" Key="Software\TrayLeaf\Installer" Name="InstallPath" Type="raw" Win64="yes" />
    </Property>
    <Property Id="NETFRAMEWORK48" Secure="yes">
      <RegistrySearch Id="Net48" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Win64="yes" />
    </Property>
    <!-- MSI reports legacy OS versions on modern Windows; read the real build instead. -->
    <Property Id="OSBUILD" Secure="yes">
      <RegistrySearch Id="RealWindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="需要 Windows 10/11 x64。">Installed OR (VersionNT64 AND OSBUILD &gt;= 10240)</Condition>
    <Condition Message="请先安装 Microsoft .NET Framework 4.8 或更高的 4.x 就地版本，再运行本安装程序。">Installed OR NETFRAMEWORK48 &gt;= &quot;#528040&quot;</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="TrayLeaf">
            <Component Id="ApplicationFiles" Guid="{544F9036-1516-541E-A787-F4AABB6225D4}" Win64="yes">
              <File Id="AppExe" Name="TrayLeaf.exe" Source="$(var.PayloadDir)\TrayLeaf.exe" />
              <File Id="AppConfig" Name="TrayLeaf.config" Source="$(var.PayloadDir)\TrayLeaf.config" />
              <File Id="ToolLicense" Name="WiX-LICENSE.txt" Source="WiX-LICENSE.txt" />
              <RemoveFile Id="RemoveOldExeConfig" Name="TrayLeaf.exe.config" On="install" />
              <RemoveFile Id="RemoveOldUsage" Name="使用说明.txt" On="install" />
              <RemoveFile Id="RemoveOldTutorial" Name="使用教程.txt" On="install" />
              <RemoveFile Id="RemoveOldChangeTxt" Name="更新日志.txt" On="install" />
              <RemoveFile Id="RemoveOldDesktopName" Name="托盘管家 TrayLeaf.lnk" Directory="DesktopFolder" On="install" />
            <RemoveFile Id="RemoveOldChangelog" Name="更新说明.txt" On="install" />
            <RegistryValue Root="HKCU" Key="Software\TrayLeaf\Installer" Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\TrayLeaf\Installer" Name="DesktopChoice" Type="string" Value="[DESKTOP_SHORTCUT]" />
              <RegistryValue Root="HKCU" Key="Software\TrayLeaf\Installer" Name="MenuChoice" Type="string" Value="[STARTMENU_SHORTCUT]" />
              <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
              <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
            </Component>
            <Component Id="StartupFallback" Guid="{BBE4E3EE-7F03-4709-B107-C988EA12D33E}" Win64="yes">
              <Condition>AUTO_START = "1"</Condition>
              <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="TrayLeaf" Type="string" Value="&quot;[INSTALLFOLDER]TrayLeaf.exe&quot; --startup" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="TrayLeaf">
          <Component Id="StartMenuShortcut" Guid="{36614DEE-7F5A-50E3-860C-8585467DE1EA}" Win64="yes">
            <Condition>STARTMENU_SHORTCUT = "1"</Condition>
            <RemoveFile Id="RemoveOldMenuName" Name="托盘管家 TrayLeaf.lnk" On="install" />
            <Shortcut Id="StartMenuLink" Name="轻羽归栈" Target="[INSTALLFOLDER]TrayLeaf.exe" WorkingDirectory="INSTALLFOLDER" Icon="TrayLeafIcon" Description="游戏前关闭选定后台，结束后按需重新启动" />
            <RemoveFile Id="RemoveOldUsageShortcut" Name="使用说明.lnk" On="install" />
            <RemoveFolder Id="RemoveMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\TrayLeaf\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="{DB2E7DA1-46E7-5DAA-977F-1E38BB63AE51}" Win64="yes">
          <Condition>DESKTOP_SHORTCUT = "1"</Condition>
          <Shortcut Id="DesktopLink" Name="轻羽归栈" Target="[INSTALLFOLDER]TrayLeaf.exe" WorkingDirectory="INSTALLFOLDER" Icon="TrayLeafIcon" />
          <RegistryValue Root="HKCU" Key="Software\TrayLeaf\Installer" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <!-- Configure startup only after commit; UAC consent is needed only for the highest-privilege task. A cancelled consent leaves the ordinary Run entry available. -->
    <CustomAction Id="ConfigureStartup" FileKey="AppExe" ExeCommand="--configure-startup &quot;[AUTO_START]&quot;" Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="RemoveStartup" FileKey="AppExe" ExeCommand="--remove-startup" Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="AppendProductFolderWithSlash" Property="INSTALLFOLDER" Value="[INSTALLFOLDER]TrayLeaf\" />
    <CustomAction Id="AppendProductFolder" Property="INSTALLFOLDER" Value="[INSTALLFOLDER]\TrayLeaf\" />
    <Binary Id="FolderPickerBinary" SourceFile="$(var.FolderPickerCA)" />
    <CustomAction Id="BrowseInstallFolder" BinaryKey="FolderPickerBinary" DllEntry="BrowseInstallFolder" Execute="immediate" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="AppendProductFolderWithSlash" Before="AppendProductFolder"><![CDATA[NOT Installed AND NOT REMOVE AND INSTALLFOLDER AND INSTALLFOLDER ~>> "\" AND NOT (INSTALLFOLDER ~>> "\TrayLeaf" OR INSTALLFOLDER ~>> "\TrayLeaf\")]]></Custom>
      <Custom Action="AppendProductFolder" Before="CostFinalize"><![CDATA[NOT Installed AND NOT REMOVE AND INSTALLFOLDER AND NOT (INSTALLFOLDER ~>> "\" OR INSTALLFOLDER ~>> "\TrayLeaf")]]></Custom>
      <Custom Action="RemoveStartup" Before="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="ConfigureStartup" After="InstallFinalize">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
    <Icon Id="TrayLeafIcon" SourceFile="..\assets\TrayLeaf.ico" />
    <Feature Id="Main" Title="TrayLeaf" Level="1" Absent="disallow">
      <ComponentRef Id="StartupFallback" /><ComponentRef Id="ApplicationFiles" /><ComponentRef Id="StartMenuShortcut" /><ComponentRef Id="DesktopShortcut" />
    </Feature>
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UI Id="TrayLeafUI">
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Property="REINSTALLMODE" Value="amus" Order="1">1</Publish>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei" Size="13" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei" Size="10" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />
      <DialogRef Id="DiskCostDlg" /><DialogRef Id="ErrorDlg" /><DialogRef Id="FatalError" /><DialogRef Id="FilesInUse" /><DialogRef Id="MsiRMFilesInUse" /><DialogRef Id="PrepareDlg" /><DialogRef Id="ResumeDlg" /><DialogRef Id="UserExit" />
      <InstallUISequence><Show Dialog="ProgressDlg" Before="ExecuteAction">0</Show><Show Dialog="TrayLeafProgressDlg" Before="ExecuteAction">1</Show></InstallUISequence>
      <Dialog Id="TrayLeafProgressDlg" Width="370" Height="270" Title="[ProductName] 安装向导" Modeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="18" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}正在安装 [ProductName]"/>
        <Control Id="Description" Type="Text" X="20" Y="65" Width="330" Height="30" NoPrefix="yes" Text="安装过程中将更新程序与快捷方式，请稍候"/>
        <Control Id="StatusLabel" Type="Text" X="20" Y="103" Width="35" Height="18" NoPrefix="yes" Text="状态："/>
        <Control Id="ActionText" Type="Text" X="58" Y="103" Width="292" Height="26" NoPrefix="yes" Text="正在准备安装，请稍候…"><Subscribe Event="ActionText" Attribute="Text"/></Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="137" Width="330" Height="12" ProgressBlocks="yes"><Subscribe Event="SetProgress" Attribute="Progress"/></Control>
        <Control Id="PreparationNote" Type="Text" X="20" Y="160" Width="330" Height="35" NoPrefix="yes" Text="开始时 Windows 需要检查安装权限和已有版本；进度会在准备完成后更新"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="上一步"/>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Disabled="yes" Text="下一步"/>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="取消"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
      </Dialog>
      <!-- Own the picker so normalization and path validation happen before it closes. -->
      <Dialog Id="TrayLeafInstallDirDlg" Width="370" Height="270" Title="[ProductName] 安装向导">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}目标文件夹" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="16" Transparent="yes" NoPrefix="yes" Text="选择安装位置与快捷方式，下一步开始安装" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="65" Width="330" Height="22" NoPrefix="yes" Text="将轻羽归栈安装到以下文件夹：" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="95" Width="330" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="124" Width="62" Height="20" Text="更改(&amp;C)…" />
        <Control Id="Desktop" Type="CheckBox" X="94" Y="124" Width="100" Height="20" Property="DESKTOP_SHORTCUT" CheckBoxValue="1" Text="桌面快捷方式" />
        <Control Id="StartMenu" Type="CheckBox" X="198" Y="124" Width="83" Height="20" Property="STARTMENU_SHORTCUT" CheckBoxValue="1" Text="开始菜单" />
        <Control Id="AutoStart" Type="CheckBox" X="285" Y="124" Width="73" Height="20" Property="AUTO_START" CheckBoxValue="1" Text="开机自启动" />
        <Control Id="Line" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="下一步(&amp;N)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="TrayLeafInstallDirDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Next" Event="DoAction" Value="AppendProductFolderWithSlash" Order="1"><![CDATA[INSTALLFOLDER AND INSTALLFOLDER ~>> "\" AND NOT (INSTALLFOLDER ~>> "\TrayLeaf" OR INSTALLFOLDER ~>> "\TrayLeaf\")]]></Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Next" Event="DoAction" Value="AppendProductFolder" Order="2"><![CDATA[INSTALLFOLDER AND NOT (INSTALLFOLDER ~>> "\" OR INSTALLFOLDER ~>> "\TrayLeaf")]]></Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="3">1</Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="4">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="5"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="Next" Event="EndDialog" Value="Return" Order="6">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="ChangeFolder" Event="DoAction" Value="BrowseInstallFolder" Order="1">1</Publish>
      <!-- Publish the returned value in the UI so PathEdit receives a property change. -->
      <Publish Dialog="TrayLeafInstallDirDlg" Control="ChangeFolder" Property="INSTALLFOLDER" Value="[TRAYLEAF_SELECTED_FOLDER]" Order="2">TRAYLEAF_SELECTED_FOLDER</Publish>
      <Publish Dialog="TrayLeafInstallDirDlg" Control="ChangeFolder" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="3">TRAYLEAF_SELECTED_FOLDER</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="TrayLeafInstallDirDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">Installed AND PATCH</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Product>
</Wix>
