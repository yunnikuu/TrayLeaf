    </DataGrid.Columns></DataGrid></Border>
    <DockPanel Grid.Row="3" Margin="0,16,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="EditRestoreButton" Content="启动信息"/><Button x:Name="SelectRestoreButton" Content="选择待恢复项"/><Button x:Name="RestoreButton" Content="开启所选程序" Style="{StaticResource Primary}" Margin="0"/></StackPanel><TextBlock x:Name="RestoreHotkeyText" TextWrapping="Wrap" FontSize="11" Text="Ctrl + Alt + 2" Foreground="#64768A" VerticalAlignment="Center"/></DockPanel>
   </Grid>
   <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="外观与显示" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="选择已安装的字体，保存后立即应用默认使用微软雅黑" Foreground="#64768A" TextWrapping="Wrap" Margin="0,8,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="FontFamilyInput" DisplayMemberPath="Label" SelectedValuePath="Source" IsTextSearchEnabled="True" TextSearch.TextPath="Label" MaxDropDownHeight="280" MinHeight="36" VerticalContentAlignment="Center" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Margin="0,0,12,0" ToolTip="输入字体名称可快速定位；仅显示本机已安装字体"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox>
      <Button x:Name="ResetFontButton" Grid.Column="1" Content="默认字体" Margin="0"/>
     </Grid>
     <Border Background="#F4F7FB" CornerRadius="7" Padding="14,12" Margin="0,12,0,10"><TextBlock x:Name="FontPreview" Text="让后台暂时休息  Aa 0123456789" FontSize="17" TextWrapping="Wrap"/></Border>
     <TextBlock Text="自动跟随 Windows 显示缩放，适配 2K / 4K 与不同 DPI 的显示器请在 Windows 显示设置中调整缩放比例" Foreground="#64768A" FontSize="12" TextWrapping="Wrap"/>
     <Border Height="1" Background="#DCE4EF" Margin="0,20"/>

     <TextBlock Text="全局快捷键" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="在输入框内按下组合键两个动作设为相同键位时，自动切换关闭与恢复" Foreground="#64768A" Margin="0,8,0,16" TextWrapping="Wrap"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="关闭所选程序" VerticalAlignment="Center"/><TextBox x:Name="CloseHotkeyInput" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,12" ToolTip="按组合键；Delete 清除"/><TextBlock Grid.Row="1" Text="恢复待开启程序" VerticalAlignment="Center"/><TextBox x:Name="RestoreHotkeyInput" Grid.Column="1" Grid.Row="1" IsReadOnly="True" ToolTip="按组合键；Delete 清除"/></Grid>
     <Border Height="1" Background="#DCE4EF" Margin="0,24"/>
     <TextBlock Text="识别与保护" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <CheckBox x:Name="WarnRisk" Content="关闭系统关键进程 / Windows 服务前弹出提醒" Margin="0,0,0,11"/>
     <TextBlock Text="包含 svchost 和承载 Windows 服务的进程关闭提醒后仍保留风险标记，系统拒绝结束的进程会显示失败原因" Foreground="#64768A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <CheckBox x:Name="ShowCandidates" Content="补充显示托盘候选（历史图标记录匹配到仍运行的程序）" Margin="0,0,0,10"/>
     <CheckBox x:Name="MinimizeToTray" Content="最小化时隐藏到托盘" Margin="0,0,0,10"/>
     <CheckBox x:Name="LaunchHidden" Content="启动后直接驻留托盘" Margin="0,0,0,10"/>
     <Border Height="1" Background="#DCE4EF" Margin="0,20"/>
     <TextBlock Text="已移除的程序" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock x:Name="HiddenCountText" Text="尚未移除程序" Foreground="#64768A" TextWrapping="Wrap" Margin="0,8,0,12"/>
     <Button x:Name="ManageHiddenButton" Content="管理已移除程序" HorizontalAlignment="Left" ToolTip="选择程序恢复到当前列表；不会启动程序"/>
     <Border Height="1" Background="#DCE4EF" Margin="0,20"/>
     <TextBlock Text="本地数据" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DbPathText" Foreground="#64768A" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8"/><TextBlock Text="记录名称、路径、启动参数、选择与权限，以及关闭批次参数可能含敏感信息；数据仅保存在当前用户的本地数据库" Foreground="#64768A" TextWrapping="Wrap" FontSize="12"/>
     <StackPanel Orientation="Horizontal" Margin="0,24,0,12"><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}"/><Button x:Name="ExitButton" Content="退出托盘管家"/></StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="StatusBar" Grid.Row="2" Margin="0,18,0,0" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="StatusText" Text="" Foreground="#64768A" FontSize="11" TextWrapping="Wrap"/></Border>
  </Grid>
 </Grid>
</Window>
